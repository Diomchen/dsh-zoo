{
  "name": "dsh-zoo",
  "version": "1.0.3",
  "description": "局域网 DSH 宠物：互相看得见、互相串门，还能捎一张字条或一个文件。 · LAN pets for DeepSeek Harness.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "src",
    "desktop",
    "scripts",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "test": "node --test --test-concurrency=4 test/*.test.js",
    "check": "node --check desktop/main.js && node --check desktop/preload.js && node --check desktop/renderer.js && node --check desktop/shared.js && node --check desktop/gift.js && node --check desktop/gift-preload.js && node --check desktop/farm.js && node --check desktop/farm-preload.js && node --test --test-concurrency=4 test/*.test.js",
    "install:profile": "node scripts/install.mjs",
    "uninstall:profile": "node scripts/uninstall.mjs",
    "stop-helper": "node scripts/stop-helper.mjs",
    "fake-peer": "node scripts/fake-peer.mjs",
    "smoke:desktop": "node scripts/desktop-smoke.mjs",
    "pack:release": "npm pack"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Diomchen/dsh-zoo.git"
  },
  "homepage": "https://github.com/Diomchen/dsh-zoo#readme",
  "bugs": {
    "url": "https://github.com/Diomchen/dsh-zoo/issues"
  },
  "author": "Diomchen",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "desktop-pet",
    "lan",
    "p2p"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
