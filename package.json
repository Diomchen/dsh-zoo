{
  "name": "dsh-zoo",
  "version": "1.12.1",
  "description": "局域网 DSH 宠物：互相看得见、互相串门、捎礼物，还能种地、偷菜、雇工和交易。 · LAN pets for DeepSeek Harness.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "src",
    "desktop",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "assets"
  ],
  "scripts": {
    "test": "node scripts/run-tests.mjs",
    "check": "node scripts/check-desktop.mjs && node --check scripts/lib/pet.mjs && node --check scripts/two-pets.mjs && node --check scripts/run-tests.mjs && node --check scripts/peer-probe.mjs && node --check scripts/verify-catalog-sync.mjs && npm test",
    "install:profile": "node scripts/install.mjs",
    "uninstall:profile": "node scripts/uninstall.mjs",
    "stop-helper": "node scripts/stop-helper.mjs",
    "fake-peer": "node scripts/fake-peer.mjs",
    "two-pets": "node scripts/two-pets.mjs",
    "smoke:desktop": "node scripts/desktop-smoke.mjs",
    "pack:release": "npm pack"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Diomchen/dsh-zoo.git"
  },
  "homepage": "https://github.com/Diomchen/dsh-zoo#readme",
  "bugs": {
    "url": "https://github.com/Diomchen/dsh-zoo/issues"
  },
  "author": "Diomchen",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "desktop-pet",
    "lan",
    "p2p"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
